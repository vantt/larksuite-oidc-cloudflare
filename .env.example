# --- Core Config ---
# Base URL nơi Worker của bạn được deploy (Không được kết thúc bằng dấu /)
ISSUER_BASE_URL=https://lark-oidc.your-domain.workers.dev

# Domain mặc định để tự sinh email giả lập cho user nếu Feishu không trả về email
DOMAIN=example.com

# Chọn hệ thống Lark: "true" = LarkSuite GLOBAL (accounts/open.larksuite.com),
# bỏ trống / khác "true" = Feishu CHINA (accounts.feishu.cn / open.feishu.cn).
# Mặc định là CHINA, nên với LarkSuite global PHẢI đặt LARK_MODE=true.
LARK_MODE=true

# Bật trang debug nội bộ tại ${ISSUER_BASE_URL}/test. Đặt "false" để TẮT ở production.
DEBUG_PAGE=false

# Danh sách trắng (allowlist) các redirect_uri được phép, phân cách bằng dấu phẩy.
# TÙY CHỌN — nếu để TRỐNG, Worker BỎ QUA kiểm tra và chấp nhận MỌI redirect_uri (kém an toàn).
# KHUYẾN NGHỊ BẬT ở production để chống open-redirect. Với Cloudflare Access, đặt đúng URL callback của Access:
#   https://<team>.cloudflareaccess.com/cdn-cgi/access/callback
# So khớp là CHÍNH XÁC theo new URL(value).toString() (khác trailing slash / query sẽ không match).
# Ví dụ: ALLOWED_REDIRECT_URIS=https://app1.com/callback,https://app2.com/callback
ALLOWED_REDIRECT_URIS=https://your-app.com/callback

# --- JWT Signing Config (RS256) ---
# Private Key (định dạng PEM, lưu dưới dạng chuỗi có ký tự \n)
JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----"

# Public Key (định dạng JWK)
JWT_PUBLIC_KEY_JWK='{"kty":"RSA","n":"...","e":"AQAB","alg":"RS256","kid":"your-jwt-key-id"}'

# Key ID của khóa (Trùng khớp với "kid" trong JWT_PUBLIC_KEY_JWK)
JWT_KEY_ID=your-jwt-key-id

# --- Lark (Feishu) Application Credentials ---
# LƯU Ý: Worker KHÔNG đọc App ID / App Secret từ biến môi trường.
# Client (vd Cloudflare Access) gửi client_id/client_secret theo từng request tới /token,
# và Worker chỉ chuyển tiếp sang Lark. Cấu hình App ID/Secret tại:
#   Cloudflare Access → Settings → Authentication → OIDC IdP (Client ID / Client Secret).
# Hai biến dưới chỉ để tham khảo, KHÔNG có tác dụng với runtime của Worker.
# APP_LARK_ID=cli_xxxxxxxxxxxxxxxx
# APP_LARK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Dynamic & Customizable Endpoints ---
# Các endpoint dưới đây được tự động tạo ra bằng cách ghép (compose) với ISSUER_BASE_URL.
# LƯU Ý: Các biến cấu hình dưới đây BẮT BUỘC phải là relative path (ví dụ: "/auth"),
# KHÔNG ĐƯỢC cấu hình dưới dạng Full URL (ví dụ: "https://..."). 
# Nếu cấu hình sai định dạng URL, Worker sẽ báo lỗi (throw Error) và không khởi chạy.
#
# Ví dụ cấu hình mặc định (khi không khai báo các biến dưới):
# - Authorization Endpoint = ${ISSUER_BASE_URL}/auth
# - Token Endpoint         = ${ISSUER_BASE_URL}/token
# - UserInfo Endpoint      = ${ISSUER_BASE_URL}/userinfo
# - JWKS URI               = ${ISSUER_BASE_URL}/jwks
# - Callback Prefix        = ${ISSUER_BASE_URL}/callback/
#
# ISSUER_AUTH_PATH=/auth
# ISSUER_TOKEN_PATH=/token
# ISSUER_USERINFO_PATH=/userinfo
# ISSUER_JWKS_PATH=/jwks
# ISSUER_CALLBACK_PREFIX=/callback/
